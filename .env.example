NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
# Gemini API key for Cove Search (get free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
NEXT_PUBLIC_STORAGE_WORKER_URL=https://your-worker-subdomain.workers.dev
NEXT_PUBLIC_STORAGE_UPLOAD_TOKEN=replace-with-strong-random-token

# TURN configuration (recommended: hosted coturn or TURN provider)
# Comma-separated TURN URIs, example:
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Optional LemonSqueezy store id
NEXT_PUBLIC_LEMONSQUEEZY_STORE_ID=cove-messenger
